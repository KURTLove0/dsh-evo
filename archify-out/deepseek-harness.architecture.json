  "cards": [
    {
      "dot": "cyan",
      "title": "主要路径 · 一次模型请求",
      "items": [
        "用户输入经 dsh 入口进入 Boot 按 profile/bundle 层叠组装的 Cordis 插件树",
        "Agent Loop 从事件日志派生模型历史，经 LLM 适配层调用 DeepSeek API 并流式返回",
        "响应含工具调用时进入下方执行链，结果以事件回写日志后进入下一个 step"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "宿主进程内没有特权核心，一切能力皆为可卸载插件（registration 即 effect）",
        "模型输出必须穿过 tools/pre-execute 审批瀑布（含 ask-user）才能执行",
        "子进程经沙箱降权（bwrap / Landlock / Seatbelt / Windows ACL）才触达本地系统",
        "唯一互联网出口是 DeepSeek API，凭 DEEPSEEK_API_KEY 认证"
      ]
    },
    {
      "dot": "emerald",
      "title": "外部依赖与关键事实",
      "items": [
        "外部依赖仅两类：DeepSeek API（云推理）与本地文件系统 / 子进程（工具效果落点）",
        "Cordis 框架源码内联于 vendor/，运行时不引入第三方进程",
        "Model-visible ⟺ logged：模型可见输入均可由事件日志重建",
        "一个 step = 一次模型请求 + 其工具调用；换 Provider 即整体切换执行环境（本地 ↔ 远程沙箱）"
      ]
    }
  ]
}
